<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>GlobalTrade Web Application</display-name>

    <!-- ======================================================================= -->
    <!-- Session Security & Privacy Configuration                                 -->
    <!-- ======================================================================= -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- Note: In production HTTPS deployment, enable <secure>true</secure> -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ======================================================================= -->
    <!-- Phase 5A: Dedicated Security Verification API Protection                -->
    <!-- Protects all HTTP methods under /api/security/*                         -->
    <!-- ======================================================================= -->
    <security-constraint>
        <display-name>Security Verification Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Security API</web-resource-name>
            <url-pattern>/api/security/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
            <role-name>CUSTOMS_AGENT</role-name>
            <role-name>WAREHOUSE_MANAGER</role-name>
            <role-name>VENDOR_REPRESENTATIVE</role-name>
            <role-name>CUSTOMER</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- ======================================================================= -->
    <!-- Phase 5B-1: Real Business Security API Protection                       -->
    <!-- Protects all HTTP methods under /api/business-security/*                -->
    <!-- ======================================================================= -->
    <security-constraint>
        <display-name>Business Security Verification Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Business Security API</web-resource-name>
            <url-pattern>/api/business-security/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
            <role-name>CUSTOMS_AGENT</role-name>
            <role-name>WAREHOUSE_MANAGER</role-name>
            <role-name>VENDOR_REPRESENTATIVE</role-name>
            <role-name>CUSTOMER</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- ======================================================================= -->
    <!-- Phase 10B: Production Business REST API Protection                      -->
    <!-- ======================================================================= -->
    <security-constraint>
        <display-name>Production Vendors API Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Vendors API</web-resource-name>
            <url-pattern>/api/vendors/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
            <role-name>VENDOR_REPRESENTATIVE</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Production Inventory API Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Inventory API</web-resource-name>
            <url-pattern>/api/inventory/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>WAREHOUSE_MANAGER</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Production Shipments API Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Shipments API</web-resource-name>
            <url-pattern>/api/shipments/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
            <role-name>CUSTOMS_AGENT</role-name>
            <role-name>WAREHOUSE_MANAGER</role-name>
            <role-name>CUSTOMER</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Production Customs API Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Customs API</web-resource-name>
            <url-pattern>/api/customs/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>CUSTOMS_AGENT</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
            <role-name>CUSTOMER</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Production Audit Logs API Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Audit Logs API</web-resource-name>
            <url-pattern>/api/audit-logs/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- ======================================================================= -->
    <!-- Diagnostic Security Constraints: Transactions & Interceptors Testing   -->
    <!-- Protects all HTTP methods under /api/transactions/* and /api/interceptors/* -->
    <!-- Requires ADMIN role to invoke diagnostic execution of secured EJBs      -->
    <!-- ======================================================================= -->
    <security-constraint>
        <display-name>Transaction Verification Diagnostic Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Transaction Verification API</web-resource-name>
            <url-pattern>/api/transactions/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Interceptor Verification Diagnostic Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Interceptor Verification API</web-resource-name>
            <url-pattern>/api/interceptors/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Exception Verification Diagnostic Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Exception Verification API</web-resource-name>
            <url-pattern>/api/exceptions/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Production Supply Chain Alerts API Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Alerts API</web-resource-name>
            <url-pattern>/api/alerts/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
            <role-name>CUSTOMS_AGENT</role-name>
            <role-name>WAREHOUSE_MANAGER</role-name>
            <role-name>VENDOR_REPRESENTATIVE</role-name>
            <role-name>CUSTOMER</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Timer Verification Diagnostic Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Timer Verification API</web-resource-name>
            <url-pattern>/api/timers/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
            <role-name>CUSTOMS_AGENT</role-name>
            <role-name>WAREHOUSE_MANAGER</role-name>
            <role-name>VENDOR_REPRESENTATIVE</role-name>
            <role-name>CUSTOMER</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Route Options Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Route Options API</web-resource-name>
            <url-pattern>/api/route-options/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Route Optimizations Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Route Optimizations API</web-resource-name>
            <url-pattern>/api/route-optimizations/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>Trade Compliance Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Trade Compliance API</web-resource-name>
            <url-pattern>/api/trade-compliance/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
            <role-name>CUSTOMS_AGENT</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <display-name>External System Integrations Constraint</display-name>
        <web-resource-collection>
            <web-resource-name>Protected Integrations API</web-resource-name>
            <url-pattern>/api/integrations/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>LOGISTICS_COORDINATOR</role-name>
            <role-name>CUSTOMS_AGENT</role-name>
            <role-name>WAREHOUSE_MANAGER</role-name>
            <role-name>VENDOR_REPRESENTATIVE</role-name>
            <role-name>CUSTOMER</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- ======================================================================= -->
    <!-- Authentication Mechanism: HTTP Basic with GlobalTradeCustomRealm        -->
    <!-- ======================================================================= -->
    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>GlobalTradeCustomRealm</realm-name>
    </login-config>

    <!-- ======================================================================= -->
    <!-- Application Security Role Declarations                                  -->
    <!-- ======================================================================= -->
    <security-role>
        <description>Enterprise Administrator</description>
        <role-name>ADMIN</role-name>
    </security-role>
    <security-role>
        <description>Logistics Coordinator</description>
        <role-name>LOGISTICS_COORDINATOR</role-name>
    </security-role>
    <security-role>
        <description>Customs Clearance Officer</description>
        <role-name>CUSTOMS_AGENT</role-name>
    </security-role>
    <security-role>
        <description>Warehouse Floor Manager</description>
        <role-name>WAREHOUSE_MANAGER</role-name>
    </security-role>
    <security-role>
        <description>Vendor Representative</description>
        <role-name>VENDOR_REPRESENTATIVE</role-name>
    </security-role>
    <security-role>
        <description>Consignment Customer</description>
        <role-name>CUSTOMER</role-name>
    </security-role>
    <security-role>
        <description>Internal System Identity</description>
        <role-name>SYSTEM</role-name>
    </security-role>

    <!-- Automatically deny any uncovered HTTP methods for protected resources -->
    <deny-uncovered-http-methods/>

</web-app>
