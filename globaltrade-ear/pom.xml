<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jiat.globaltrade</groupId>
        <artifactId>globaltrade-scm</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>globaltrade-ear</artifactId>
    <version>1.0.0</version>

    <packaging>ear</packaging>

    <name>GlobalTrade Enterprise Application</name>

    <dependencies>

        <dependency>
            <groupId>com.jiat.globaltrade</groupId>
            <artifactId>globaltrade-ejb</artifactId>
            <version>1.0.0</version>
            <type>ejb</type>
        </dependency>

        <dependency>
            <groupId>com.jiat.globaltrade</groupId>
            <artifactId>globaltrade-automation-ejb</artifactId>
            <version>1.0.0</version>
            <type>ejb</type>
        </dependency>

        <dependency>
            <groupId>com.jiat.globaltrade</groupId>
            <artifactId>globaltrade-web</artifactId>
            <version>1.0.0</version>
            <type>war</type>
        </dependency>

    </dependencies>

    <build>

        <finalName>globaltrade</finalName>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <version>3.3.0</version>

                <configuration>

                    <version>8</version>

                    <defaultLibBundleDir>lib</defaultLibBundleDir>

                    <generateApplicationXml>true</generateApplicationXml>

                    <modules>

                        <ejbModule>
                            <groupId>com.jiat.globaltrade</groupId>
                            <artifactId>globaltrade-ejb</artifactId>
                            <bundleFileName>globaltrade-ejb.jar</bundleFileName>
                        </ejbModule>

                        <ejbModule>
                            <groupId>com.jiat.globaltrade</groupId>
                            <artifactId>globaltrade-automation-ejb</artifactId>
                            <bundleFileName>globaltrade-automation-ejb.jar</bundleFileName>
                        </ejbModule>

                        <webModule>
                            <groupId>com.jiat.globaltrade</groupId>
                            <artifactId>globaltrade-web</artifactId>
                            <bundleFileName>globaltrade-web.war</bundleFileName>
                            <contextRoot>/globaltrade</contextRoot>
                        </webModule>

                    </modules>

                </configuration>

            </plugin>

        </plugins>

    </build>

</project>