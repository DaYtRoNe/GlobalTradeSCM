<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian
                                http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <defaultProtocol type="Servlet 5.0"/>

    <container qualifier="payara-remote" default="true">
        <configuration>
            <property name="adminHost">localhost</property>
            <property name="adminPort">4848</property>
            <property name="adminUser">admin</property>
            <property name="adminPassword">${payara.adminPassword:}</property>
            <property name="adminHttps">false</property>
            <property name="authorisation">false</property>
            <property name="httpHost">localhost</property>
            <property name="httpPort">8080</property>
        </configuration>
    </container>

</arquillian>
