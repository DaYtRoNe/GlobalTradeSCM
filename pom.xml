<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jiat.globaltrade</groupId>
    <artifactId>globaltrade-scm</artifactId>
    <version>1.0.0</version>

    <packaging>pom</packaging>

    <name>GlobalTrade Supply Chain Management System</name>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakartaee.version>10.0.0</jakartaee.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <arquillian.bom.version>1.9.3.Final</arquillian.bom.version>
        <payara.arquillian.version>3.1</payara.arquillian.version>
        <maven.failsafe.version>3.2.5</maven.failsafe.version>
        <maven.surefire.version>3.2.5</maven.surefire.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- JUnit 5 Dependency Management -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Arquillian Dependency Management -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>globaltrade-security-provider</module>
        <module>globaltrade-ejb</module>
        <module>globaltrade-web</module>
        <module>globaltrade-ear</module>
    </modules>

</project>